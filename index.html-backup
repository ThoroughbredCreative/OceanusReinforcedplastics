  <!-- ==================== CONTACT ==================== -->
  <section id="contact">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Contact</span>
        <h2>Request a quote</h2>
        <p>Send us your project details and we'll follow up with next steps — or call us directly.</p>
      </div>

      <div class="contact-grid">
        <div class="reveal">
          <div id="form-success" class="form-success" role="status" tabindex="-1">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="8 12 11 15 16 9"/></svg>
            Thanks — your message has been received. We'll be in touch shortly.
          </div>

          <form id="contact-form" novalidate>
            <div class="field">
              <label for="name">Name <span class="req">*</span></label>
              <input type="text" id="name" name="name" required autocomplete="name">
              <div class="field-error">Please enter your name.</div>
            </div>

            <div class="field">
              <label for="email">Email <span class="req">*</span></label>
              <input type="email" id="email" name="email" required autocomplete="email">
              <div class="field-error">Please enter a valid email.</div>
            </div>

            <div class="field">
              <label for="phone">Phone</label>
              <input type="tel" id="phone" name="phone" autocomplete="tel">
            </div>

            <div class="field">
              <label for="service">Service required <span class="req">*</span></label>
              <select id="service" name="service" required>
                <option value="">Select a service</option>
                <option value="vacuum-infusion">Vacuum Infusion Manufacturing</option>
                <option value="hand-layup">Hand Layup Composites</option>
                <option value="tooling">Custom Mold &amp; Tooling</option>
                <option value="marine">Marine Composite Parts</option>
                <option value="repair">Fibreglass Repair &amp; Refinishing</option>
                <option value="industrial">Industrial Composite Parts</option>
                <option value="other">Not sure / other</option>
              </select>
              <div class="field-error">Please select a service.</div>
            </div>

            <div class="field">
              <label for="message">Project details <span class="req">*</span></label>
              <textarea id="message" name="message" required placeholder="Tell us about the part, timeline and any drawings or dimensions you have."></textarea>
              <div class="field-error">Please add a few details about your project.</div>
            </div>

            <fieldset class="field" style="border:none; padding:0;">
              <legend style="font-weight:600; font-size:0.88rem; color:var(--navy-900); margin-bottom:0.5rem;">Preferred contact method</legend>
              <div class="radio-row">
                <label><input type="radio" name="contact-method" value="email" checked> Email</label>
                <label><input type="radio" name="contact-method" value="phone"> Phone</label>
              </div>
            </fieldset>

            <button type="submit" class="btn btn-primary btn-block">Send Request</button>
            <p style="font-size:0.82rem; color: var(--ink-400); margin-top:0.9rem;">Your information is only used to respond to your enquiry. See our <a href="privacy.html">Privacy Policy</a>.</p>
          </form>
        </div>

        <div class="reveal">
          <div class="contact-info-card">
            <div class="contact-info-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 2 .7 3a2 2 0 0 1-.4 2.1L8 10.1a16 16 0 0 0 6 6l1.3-1.4a2 2 0 0 1 2.1-.4c1 .4 2 .6 3 .7a2 2 0 0 1 1.6 2Z"/></svg>
              <div>
                <h3>Call Us</h3>
                <p><a href="tel:+12506567733">(250) 656-7733</a></p>
              </div>
            </div>
            <div class="contact-info-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20c4-4 8-7.5 8-12a8 8 0 1 0-16 0c0 4.5 4 8 8 12Z"/><circle cx="12" cy="8" r="2.5"/></svg>
              <div>
                <h3>Visit Us</h3>
                <p>1949 Marina Way<br>North Saanich Marina<br>North Saanich, BC V8L 6B3</p>
              </div>
            </div>
            <div class="contact-info-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
              <div>
                <h3>Hours</h3>
                <p>Monday–Friday, from 8:00 a.m.<br>Closed Saturday &amp; Sunday<br><span style="font-size:0.82rem;">Please call to confirm same-day hours.</span></p>
              </div>
            </div>
            <div class="contact-info-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 13l3-9 4 6 4-9 4 9 3-6v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z"/></svg>
              <div>
                <h3>Service Area</h3>
                <p>North Saanich, Greater Victoria and Vancouver Island, BC</p>
              </div>
            </div>
            <div class="map-embed">
              <iframe
                src="https://www.google.com/maps?q=1949+Marina+Way,+North+Saanich,+BC+V8L+6B3&output=embed"
                title="Map showing Oceanus Reinforced Plastics at 1949 Marina Way, North Saanich, BC"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade">
