<meta name="theme-color" content="#0a2233">

<meta property="og:type" content="website">
<meta property="og:title" content="Oceanus Reinforced Plastics | Composites Manufacturer, North Saanich BC">
<meta property="og:description" content="Semi-custom composites manufacturing via hand layup and vacuum infusion. Based at North Saanich Marina, BC.">
<meta property="og:url" content="https://www.oceanusreinforcedplastics.com/">
