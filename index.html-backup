  <!-- ==================== SERVICE DETAIL ==================== -->
  <section id="vacuum-infusion">
    <div class="container">
      <div class="about-grid">
        <div class="about-copy reveal">
          <span class="eyebrow">01</span>
          <h3 style="font-size:1.6rem;">Vacuum Infusion Manufacturing</h3>
          <p class="lead">Resin is drawn through dry fibre under vacuum, producing parts with a consistent resin-to-fibre ratio.</p>
          <p>Vacuum infusion suits structural or weight-sensitive parts where consistency and strength-to-weight matter, and works well for both one-off components and repeat runs from a shared mold.</p>
          <ul style="margin-top:1.2rem;">
            <li style="margin-bottom:0.6rem; display:flex; gap:0.6rem; align-items:flex-start;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1c7c8c" stroke-width="2" style="flex-shrink:0;margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg><span>Lighter, more consistent parts than open hand layup</span></li>
            <li style="margin-bottom:0.6rem; display:flex; gap:0.6rem; align-items:flex-start;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1c7c8c" stroke-width="2" style="flex-shrink:0;margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg><span>Reduced resin waste and cleaner shop environment</span></li>
            <li style="display:flex; gap:0.6rem; align-items:flex-start;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1c7c8c" stroke-width="2" style="flex-shrink:0;margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg><span>Well suited to structural marine and industrial components</span></li>
          </ul>
          <a href="#contact" class="btn btn-primary mt-lg">Request a Quote</a>
        </div>
        <div class="img-placeholder light reveal">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="14" rx="1"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5-9 9"/></svg>
          <span class="ph-label">Photo needed</span>
          <span class="ph-sub">Vacuum infusion bag and resin lines on a part</span>
        </div>
      </div>
    </div>
  </section>

  <section id="hand-layup" style="background: var(--sand-100);">
    <div class="container">
      <div class="about-grid">
        <div class="img-placeholder light reveal">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21c3-1 6-3 8-6 3.5-5 4-10 4-12 2 0 6 2 6 8 0 6-6 10-10 10-3 0-6-1-8 0Z"/></svg>
          <span class="ph-label">Photo needed</span>
          <span class="ph-sub">Technician hand-laying fibreglass into a mold</span>
        </div>
        <div class="about-copy reveal">
          <span class="eyebrow">02</span>
          <h3 style="font-size:1.6rem;">Hand Layup Composites</h3>
          <p class="lead">Resin and fibreglass are applied by hand for maximum flexibility on shape and detail.</p>
          <p>Hand layup is the right fit for custom geometry, small production runs, and structural repairs where a mold isn't practical or available.</p>
          <ul style="margin-top:1.2rem;">
            <li style="margin-bottom:0.6rem; display:flex; gap:0.6rem; align-items:flex-start;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1c7c8c" stroke-width="2" style="flex-shrink:0;margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg><span>Ideal for custom shapes and one-off parts</span></li>
            <li style="margin-bottom:0.6rem; display:flex; gap:0.6rem; align-items:flex-start;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1c7c8c" stroke-width="2" style="flex-shrink:0;margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg><span>Practical for structural repairs and patch work</span></li>
            <li style="display:flex; gap:0.6rem; align-items:flex-start;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1c7c8c" stroke-width="2" style="flex-shrink:0;margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg><span>No mold required for many repair jobs</span></li>
          </ul>
          <a href="#contact" class="btn btn-primary mt-lg">Request a Quote</a>
        </div>
      </div>
    </div>
  </section>

