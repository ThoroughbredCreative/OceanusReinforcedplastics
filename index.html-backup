  <!-- ==================== SERVICES ==================== -->
  <section id="services">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">What We Build</span>
        <h2>Composite manufacturing services</h2>
        <p>Semi-custom parts produced with the process that fits your project — from one-off components to short production runs.</p>
      </div>

      <div class="grid cols-3">
        <article class="card service-card reveal">
          <div class="card-body">
            <div class="icon-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            </div>
            <h3>Vacuum Infusion Manufacturing</h3>
            <p>Precision resin infusion for lighter, stronger, more consistent composite parts.</p>
            <a href="#vacuum-infusion" class="card-link">Learn more <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
          </div>
        </article>

        <article class="card service-card reveal">
          <div class="card-body">
            <div class="icon-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21c3-1 6-3 8-6 3.5-5 4-10 4-12 2 0 6 2 6 8 0 6-6 10-10 10-3 0-6-1-8 0Z"/></svg>
            </div>
            <h3>Hand Layup Composites</h3>
            <p>Skilled hand layup for custom shapes, repairs and low-volume parts.</p>
            <a href="#hand-layup" class="card-link">Learn more <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
          </div>
        </article>

        <article class="card service-card reveal">
