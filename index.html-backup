<main id="main">
  <!-- ==================== HERO ==================== -->
  <section class="hero" id="top" style="--hero-img: url('images/ChatGPT%20Image%20Jul%2015%2C%202026%2C%2011_04_41%20AM.png');">
    <div class="compass-wrap" aria-hidden="true">
      <svg class="compass-rose" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="100" cy="100" r="95" stroke="rgba(39,154,173,0.35)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <circle cx="100" cy="100" r="80" stroke="rgba(39,154,173,0.2)" stroke-width="0.5"/>
